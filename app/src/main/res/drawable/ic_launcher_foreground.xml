<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer Shield Glow Ring -->
    <path
        android:pathData="M54,20 L80,32 L80,56 C80,72 54,88 54,88 C54,88 28,72 28,56 L28,32 Z"
        android:strokeWidth="2.5"
        android:strokeLineJoin="round"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="28"
                android:startY="20"
                android:endX="80"
                android:endY="88"
                android:type="linear">
                <item android:color="#00D084" android:offset="0.0" />
                <item android:color="#06B6D4" android:offset="0.5" />
                <item android:color="#3B82F6" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Shield Body -->
    <path
        android:pathData="M54,25 L75,35 L75,55 C75,68 54,82 54,82 C54,82 33,68 33,55 L33,35 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="25"
                android:endX="54"
                android:endY="82"
                android:type="linear">
                <item android:color="#CC13222B" android:offset="0.0" />
                <item android:color="#E60A1318" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Stylized Nebula "N" & Lock/Energy Core -->
    <!-- Left Wing of N -->
    <path
        android:pathData="M43,40 L49,40 L49,68 L43,68 Z"
        android:fillColor="#00D084" />

    <!-- Right Wing of N -->
    <path
        android:pathData="M59,40 L65,40 L65,68 L59,68 Z"
        android:fillColor="#06B6D4" />

    <!-- Diagonal Cyber Bridge of N -->
    <path
        android:pathData="M49,40 L65,62 L59,68 L43,46 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="43"
                android:startY="40"
                android:endX="65"
                android:endY="68"
                android:type="linear">
                <item android:color="#00D084" android:offset="0.0" />
                <item android:color="#06B6D4" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center Pulse Spark -->
    <path
        android:pathData="M54,50 L56.5,54 L54,58 L51.5,54 Z"
        android:fillColor="#FFFFFF" />

</vector>
